# Brandreel — local dev image (Next.js 16 + Remotion 4).
#
# Unlike the project's own production Dockerfile, this one does NOT copy or build
# the app: the source tree is bind-mounted from the host and `npm run dev` runs
# with live reload (see docker-compose.yml + entrypoint-brand_reel.sh). Node deps
# live in a named volume so the container builds its own (correct-arch) binaries
# without clobbering the host's node_modules.
FROM node:22-bookworm-slim

ENV LANG=C.UTF-8 \
    LC_ALL=C.UTF-8

# System libraries required by the headless Chromium that Remotion drives for
# server-side MP4 rendering. (ffmpeg ships inside @remotion/renderer, so it is
# not installed here.) git is handy for any tooling that shells out to it.
RUN apt-get update -qq && apt-get install -y --no-install-recommends \
      ca-certificates curl git fonts-liberation \
      libnss3 libdbus-1-3 libatk1.0-0 libatk-bridge2.0-0 libgbm1 \
      libasound2 libxrandr2 libxkbcommon0 libxfixes3 libxcomposite1 \
      libxdamage1 libpango-1.0-0 libcairo2 libcups2 libxshmfence1 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

EXPOSE 3040

CMD ["bash"]
